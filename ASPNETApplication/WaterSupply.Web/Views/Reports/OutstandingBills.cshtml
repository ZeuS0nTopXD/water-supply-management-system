@model WaterSupply.Web.Models.ReportViewModels.OutstandingBillsReportViewModel
@{ ViewData["Title"] = "Outstanding Bills Report"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Outstanding bills report</h1><button class="btn btn-outline-secondary no-print" onclick="window.print()">Print</button></div><form method="get" class="row g-2 mb-3 no-print"><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<BillStatus>()) { <option value="@status" selected="@(Model.Status == status.ToString())">@status</option> }</select></div><div class="col-md-3"><input name="from" value="@Model.From?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div><div class="col-md-3"><input name="to" value="@Model.To?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div><div class="col-md-3"><button class="btn btn-outline-secondary">Apply filters</button></div></form><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Bill</th><th>Connection</th><th>Period end</th><th>Due</th><th>Outstanding</th><th>Status</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td>#@row.BillId</td><td>@row.WaterConnectionId</td><td>@row.BillingPeriodEnd</td><td>@row.DueDate</td><td>@row.OutstandingAmount.ToString("C")</td><td>@row.Status</td></tr> }</tbody><tfoot><tr><th colspan="4">Total outstanding</th><th>@Model.TotalOutstanding.ToString("C")</th><th></th></tr></tfoot></table></div>
