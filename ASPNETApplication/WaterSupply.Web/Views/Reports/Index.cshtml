@model BillReportViewModel
@{ ViewData["Title"] = "Bill Report"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Bill report</h1><button class="btn btn-outline-secondary no-print" type="button" onclick="window.print()">Print report</button></div>
<form method="get" class="row g-2 mb-3 no-print"><div class="col-md-5"><label class="visually-hidden" for="report-search">Search by connection number</label><input id="report-search" name="search" value="@Model.Search" class="form-control" placeholder="Search by connection number" /></div><div class="col-md-5"><label class="visually-hidden" for="report-status">Filter report by status</label><select id="report-status" name="status" class="form-select"><option value="">All statuses</option><option value="Unpaid" selected="@(Model.Status == BillStatus.Unpaid ? "selected" : null)">Unpaid</option><option value="Paid" selected="@(Model.Status == BillStatus.Paid ? "selected" : null)">Paid</option></select></div><div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="submit">Filter report</button></div></form>
@if (Model.Rows.Count == 0)
{
    <div class="alert alert-light border">No bills match the selected filters.</div>
}
else
{
<div class="table-responsive"><table class="table table-bordered align-middle"><thead><tr><th>Bill</th><th>Connection number</th><th>Bill date</th><th>Total amount</th><th>Due date</th><th>Status</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td>#@row.BillId</td><td>@row.ConnectionNumber</td><td>@row.BillDate</td><td>@row.TotalAmount.ToString("C")</td><td>@row.DueDate</td><td>@row.Status</td></tr> }</tbody><tfoot><tr><th colspan="3">Total</th><th>@Model.TotalAmount.ToString("C")</th><th colspan="2"></th></tr></tfoot></table></div>
}
