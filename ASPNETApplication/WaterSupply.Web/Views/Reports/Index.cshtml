@model BillReportViewModel
@{ ViewData["Title"] = "Bill Report"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Bill report</h1><button class="btn btn-outline-secondary no-print" onclick="window.print()">Print</button></div>
<form method="get" class="row g-2 mb-3 no-print"><div class="col-md-5"><input name="search" value="@Model.Search" class="form-control" placeholder="Connection ID" /></div><div class="col-md-5"><select name="status" class="form-select"><option value="">All statuses</option><option value="Unpaid">Unpaid</option><option value="Paid">Paid</option></select></div><div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filter</button></div></form>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Bill</th><th>Connection</th><th>Date</th><th>Total</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td>#@row.BillId</td><td>@row.WaterConnectionId</td><td>@row.BillDate</td><td>@row.TotalAmount.ToString("C")</td><td>@row.DueDate</td><td>@row.Status</td></tr> }</tbody><tfoot><tr><th colspan="3">Total</th><th>@Model.TotalAmount.ToString("C")</th><th colspan="2"></th></tr></tfoot></table></div>
