@model WaterSupply.Web.Models.ReportViewModels.PaymentsReportViewModel
@{ ViewData["Title"] = "Payments Report"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Payments report</h1><button class="btn btn-outline-secondary no-print" onclick="window.print()">Print</button></div><form method="get" class="row g-2 mb-3 no-print"><div class="col-md-4"><input name="from" type="date" class="form-control" /></div><div class="col-md-4"><input name="to" type="date" class="form-control" /></div><div class="col-md-4"><button class="btn btn-outline-secondary">Apply filters</button></div></form><table class="table table-bordered"><thead><tr><th>Reference</th><th>Bill</th><th>Amount</th><th>Method</th><th>Date</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td>@row.ReferenceNumber</td><td>#@row.BillId</td><td>@row.Amount.ToString("C")</td><td>@row.PaymentMethod</td><td>@row.PaymentDate</td></tr> }</tbody><tfoot><tr><th colspan="2">Total collected</th><th>@Model.TotalCollected.ToString("C")</th><th colspan="2"></th></tr></tfoot></table>
