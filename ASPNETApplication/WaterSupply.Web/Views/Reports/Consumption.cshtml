@model WaterSupply.Web.Models.ReportViewModels.ConsumptionReportViewModel
@{ ViewData["Title"] = "Consumption Report"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Consumption report</h1><button class="btn btn-outline-secondary no-print" onclick="window.print()">Print</button></div><form method="get" class="row g-2 mb-3 no-print"><div class="col-md-4"><input name="from" type="date" class="form-control" /></div><div class="col-md-4"><input name="to" type="date" class="form-control" /></div><div class="col-md-4"><button class="btn btn-outline-secondary">Apply filters</button></div></form><table class="table table-bordered"><thead><tr><th>Connection</th><th>Date</th><th>Consumption</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td>@row.ConnectionNumber</td><td>@row.ReadingDate</td><td>@row.Consumption</td></tr> }</tbody><tfoot><tr><th colspan="2">Total</th><th>@Model.TotalConsumption</th></tr></tfoot></table>
