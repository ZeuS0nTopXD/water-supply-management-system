@model DashboardSummaryViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-3">
    <div><h1 class="mb-1">Dashboard</h1><p class="text-muted mb-0">Water supply overview for @Model.SelectedMonth.ToString("MMMM yyyy")</p></div>
    <div class="d-flex flex-column flex-sm-row align-items-sm-end gap-2">
        <form method="get" class="d-flex align-items-end gap-2">
            <div><label for="month" class="form-label mb-1">Reporting month</label><input id="month" name="month" type="month" value="@Model.SelectedMonthValue" class="form-control" /></div>
            <button class="btn btn-primary" type="submit">Apply</button>
        </form>
        <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="Index">View reports</a>
    </div>
</div>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-sm btn-outline-primary" asp-controller="Residents" asp-action="Create">Add resident</a>
    <a class="btn btn-sm btn-outline-primary" asp-controller="WaterConnections" asp-action="Create">Add connection</a>
    <a class="btn btn-sm btn-outline-primary" asp-controller="MeterReadings" asp-action="Create">Record reading</a>
    <a class="btn btn-sm btn-outline-primary" asp-controller="Bills" asp-action="Create">Add bill</a>
    <a class="btn btn-sm btn-outline-primary" asp-controller="ServiceRequests" asp-action="Create">New request</a>
</div>
<div class="row g-3">
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Residents</div><div class="display-6">@Model.ResidentCount</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Active connections</div><div class="display-6">@Model.ActiveConnectionCount</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Consumption</div><div class="display-6">@Model.CurrentMonthConsumption</div><small>units this month</small></div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Unpaid bills</div><div class="display-6">@Model.UnpaidBillAmount.ToString("C")</div></div></div></div>
</div>
<div class="row g-3 mt-1">
    <div class="col-md-4"><div class="card h-100 border-primary"><div class="card-body"><div class="text-muted">Active requests</div><div class="display-6">@Model.OpenServiceRequestCount</div></div></div></div>
    <div class="col-md-4"><div class="card h-100 border-warning"><div class="card-body"><div class="text-muted">In progress</div><div class="display-6">@Model.InProgressServiceRequestCount</div></div></div></div>
    <div class="col-md-4"><div class="card h-100 border-success"><div class="card-body"><div class="text-muted">Closed requests</div><div class="display-6">@Model.ClosedServiceRequestCount</div></div></div></div>
</div>
<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Recent service requests</h2><a asp-controller="ServiceRequests" asp-action="Index">View all</a></div>
        @if (Model.RecentRequests.Count == 0)
        {
            <p class="text-muted mb-0">No service requests have been recorded.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Type</th><th>Description</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody>
                @foreach (var request in Model.RecentRequests)
                {
                    <tr><td>@request.RequestType</td><td>@request.Description</td><td><span class="badge text-bg-light">@request.Status</span></td><td>@request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><a asp-controller="ServiceRequests" asp-action="UpdateStatus" asp-route-id="@request.ServiceRequestId">Update</a></td></tr>
                }
            </tbody></table></div>
        }
    </div>
</div>
<button class="btn btn-outline-primary mt-3" type="button" onclick="WaterSupplyPwa.requestBillReminderPermission()">Enable reminders</button>
