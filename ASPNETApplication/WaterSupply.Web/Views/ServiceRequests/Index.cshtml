@model IEnumerable<ServiceRequestListItemViewModel>
@{ var isResident = User.IsInRole("Resident"); ViewData["Title"] = isResident ? "My Requests" : "Service Requests"; var requests = Model.ToList(); }
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <div><h1 class="mb-1">@(isResident ? "My requests" : "Service requests")</h1><p class="text-muted mb-0">@(isResident ? "Track the issues you have reported." : "Review issues reported by residents and update their status.")</p></div>
    @if (isResident)
    {
        <a class="btn btn-primary" asp-action="Create">Report a service issue</a>
    }
</div>

@if (requests.Count == 0)
{
    <div class="alert alert-light border">No service requests have been recorded yet.</div>
}
else
{
    <div class="d-none d-md-block table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Type</th><th>Resident</th><th>Connection number</th><th>Description</th><th>Created</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var request in requests)
            {
                var statusClass = request.Status switch { RequestStatus.Closed => "text-bg-success", RequestStatus.InProgress => "text-bg-warning", _ => "text-bg-primary" };
                <tr>
                    <td>@request.RequestTypeLabel</td>
                    <td>@request.ResidentName</td>
                    <td>@(request.ConnectionNumber ?? "Not connection-specific")</td>
                    <td class="text-break">@request.Description</td>
                    <td>@request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td><span class="badge @statusClass">@request.StatusLabel</span></td>
                    <td>@if (User.IsInRole("Administrator")) { <a asp-action="UpdateStatus" asp-route-id="@request.ServiceRequestId">Update</a> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-md-none d-grid gap-3">
        @foreach (var request in requests)
        {
            var statusClass = request.Status switch { RequestStatus.Closed => "text-bg-success", RequestStatus.InProgress => "text-bg-warning", _ => "text-bg-primary" };
            <article class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div><h2 class="h5 mb-1">@request.RequestTypeLabel</h2><div class="text-muted small">@request.ResidentName</div><div class="text-muted small">@(request.ConnectionNumber ?? "Not connection-specific")</div></div>
                        <span class="badge @statusClass">@request.StatusLabel</span>
                    </div>
                    <p class="mb-3 text-break">@request.Description</p>
                    <div class="d-flex justify-content-between align-items-center small text-muted">
                        <span>@request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                        @if (User.IsInRole("Administrator")) { <a asp-action="UpdateStatus" asp-route-id="@request.ServiceRequestId">Update status</a> }
                    </div>
                </div>
            </article>
        }
    </div>
}
