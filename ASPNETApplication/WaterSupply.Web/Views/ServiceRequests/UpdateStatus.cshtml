@model WaterSupply.Web.Models.ServiceRequestViewModels.ServiceRequestStatusViewModel
@{ ViewData["Title"] = "Update Service Request"; }
<h1>Update service request</h1><form method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()" class="form-select"></select></div><div class="col-12"><label asp-for="StaffNotes" class="form-label"></label><textarea asp-for="StaffNotes" class="form-control" rows="5"></textarea></div><div class="col-12"><button class="btn btn-primary">Save status</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
