@model ServiceRequestCreateViewModel
@{ ViewData["Title"] = "Add Service Request"; var residents = ViewBag.Residents as IEnumerable<Resident> ?? []; var connections = ViewBag.Connections as IEnumerable<WaterConnection> ?? []; }
<h1>Add service request</h1>
<form asp-action="Create" method="post" class="row g-3 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="ResidentId" class="form-label"></label><select asp-for="ResidentId" class="form-select"><option value="">Select resident</option>@foreach (var resident in residents) { <option value="@resident.ResidentId">@resident.FullName</option> }</select></div>
    <div class="col-md-6"><label asp-for="WaterConnectionId" class="form-label"></label><select asp-for="WaterConnectionId" class="form-select"><option value="">No specific connection</option>@foreach (var connection in connections) { <option value="@connection.WaterConnectionId">@connection.ConnectionNumber</option> }</select></div>
    <div class="col-md-6"><label asp-for="RequestType" class="form-label"></label><select asp-for="RequestType" asp-items="Html.GetEnumSelectList<RequestType>()" class="form-select"></select></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Save request</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
