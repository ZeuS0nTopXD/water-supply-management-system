@model IEnumerable<Bill>
@{ ViewData["Title"] = "Bills"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Bills</h1><a class="btn btn-primary" asp-action="Create">Add bill</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><select name="status" class="form-select"><option value="">All statuses</option><option value="Unpaid">Unpaid</option><option value="Paid">Paid</option></select></div><div class="col-sm-4"><button class="btn btn-outline-secondary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Bill</th><th>Connection</th><th>Date</th><th>Total</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach (var bill in Model) { <tr><td>#@bill.BillId</td><td>@bill.WaterConnectionId</td><td>@bill.BillDate</td><td>@bill.TotalAmount.ToString("C")</td><td>@bill.DueDate</td><td>@bill.Status</td></tr> }</tbody></table></div>
