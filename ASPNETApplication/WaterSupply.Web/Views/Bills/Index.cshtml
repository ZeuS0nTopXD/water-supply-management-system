@model IEnumerable<Bill>
@{ ViewData["Title"] = "Bills"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Bills</h1>@if (User.IsInRole("Administrator")) { <a asp-action="Create" class="btn btn-primary">Create bill</a> }</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<BillStatus>()) { <option value="@status">@status</option> }</select></div><div class="col-md-4"><input name="waterConnectionId" class="form-control" placeholder="Connection ID" /></div><div class="col-md-4"><button class="btn btn-outline-secondary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Bill</th><th>Connection</th><th>Period end</th><th>Total</th><th>Outstanding</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var bill in Model) { <tr><td>#@bill.Id</td><td>@bill.WaterConnectionId</td><td>@bill.BillingPeriodEnd</td><td>@bill.TotalAmount.ToString("C")</td><td>@bill.OutstandingAmount.ToString("C")</td><td>@bill.Status</td><td><a asp-action="Details" asp-route-id="@bill.Id">Details</a> @if (User.IsInRole("Administrator") && bill.OutstandingAmount > 0) { <a asp-controller="Payments" asp-action="Create" asp-route-billId="@bill.Id">Pay</a> }</td></tr> }</tbody></table></div>
