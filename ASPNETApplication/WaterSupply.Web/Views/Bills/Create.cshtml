@model WaterSupply.Web.Models.BillingViewModels.BillCreateViewModel
@{ ViewData["Title"] = "Create Bill"; var connections = ViewBag.Connections as IEnumerable<WaterConnection> ?? []; }
<h1>Create bill</h1><form asp-action="Create" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="WaterConnectionId" class="form-label"></label><select asp-for="WaterConnectionId" class="form-select"><option value="">Select connection</option>@foreach (var connection in connections) { <option value="@connection.Id">@connection.ConnectionNumber</option> }</select></div><div class="col-md-6"><label asp-for="BillingPeriodStart" class="form-label"></label><input asp-for="BillingPeriodStart" class="form-control" /></div><div class="col-md-6"><label asp-for="BillingPeriodEnd" class="form-label"></label><input asp-for="BillingPeriodEnd" class="form-control" /></div><div class="col-md-6"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /></div><div class="col-md-3"><label asp-for="UnitsConsumed" class="form-label"></label><input asp-for="UnitsConsumed" class="form-control" /></div><div class="col-md-3"><label asp-for="RatePerUnit" class="form-label"></label><input asp-for="RatePerUnit" class="form-control" /></div><div class="col-md-3"><label asp-for="FixedCharge" class="form-label"></label><input asp-for="FixedCharge" class="form-control" /></div><div class="col-md-3"><label asp-for="TaxAmount" class="form-label"></label><input asp-for="TaxAmount" class="form-control" /></div><div class="col-12"><button class="btn btn-primary">Create bill</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
