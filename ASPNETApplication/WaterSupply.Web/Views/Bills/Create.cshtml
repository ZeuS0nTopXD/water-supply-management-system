@model BillCreateViewModel
@{ ViewData["Title"] = "Add Bill"; var connections = ViewBag.Connections as IEnumerable<WaterConnection> ?? []; var readings = ViewBag.Readings as IEnumerable<MeterReading> ?? []; }
<h1>Add bill</h1>
<form asp-action="Create" method="post" class="row g-3 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="WaterConnectionId" class="form-label"></label><select asp-for="WaterConnectionId" class="form-select"><option value="">Select connection</option>@foreach (var connection in connections) { <option value="@connection.WaterConnectionId">@connection.ConnectionNumber</option> }</select></div>
    <div class="col-md-6"><label asp-for="MeterReadingId" class="form-label"></label><select asp-for="MeterReadingId" class="form-select"><option value="">Select reading</option>@foreach (var reading in readings) { <option value="@reading.MeterReadingId">Reading @reading.MeterReadingId (@reading.Consumption units)</option> }</select></div>
    <div class="col-md-6"><label asp-for="BillDate" class="form-label"></label><input asp-for="BillDate" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="UnitsConsumed" class="form-label"></label><input asp-for="UnitsConsumed" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="RatePerUnit" class="form-label"></label><input asp-for="RatePerUnit" class="form-control" /></div>
    <div class="col-12"><button class="btn btn-primary">Save bill</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
