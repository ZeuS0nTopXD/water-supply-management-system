@model BillCreateViewModel
@{ ViewData["Title"] = "Add Bill"; var connections = ViewBag.Connections as IEnumerable<WaterConnection> ?? []; var readings = ViewBag.Readings as IEnumerable<MeterReading> ?? []; }
<h1>Add bill</h1>
<form asp-action="Create" method="post" class="row g-3 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-md-6"><label asp-for="WaterConnectionId" class="form-label"></label><select asp-for="WaterConnectionId" class="form-select"><option value="">Select connection</option>@foreach (var connection in connections) { <option value="@connection.WaterConnectionId">@connection.ConnectionNumber</option> }</select><span asp-validation-for="WaterConnectionId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="MeterReadingId" class="form-label"></label><select asp-for="MeterReadingId" class="form-select"><option value="">Select reading</option>@foreach (var reading in readings) { var connectionNumber = connections.FirstOrDefault(connection => connection.WaterConnectionId == reading.WaterConnectionId)?.ConnectionNumber ?? "Unknown connection"; <option value="@reading.MeterReadingId">@connectionNumber — @reading.ReadingDate (@reading.Consumption units)</option> }</select><span asp-validation-for="MeterReadingId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="BillDate" class="form-label"></label><input asp-for="BillDate" class="form-control" /><span asp-validation-for="BillDate" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="UnitsConsumed" class="form-label"></label><input asp-for="UnitsConsumed" class="form-control" min="0" step="1" /><span asp-validation-for="UnitsConsumed" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="RatePerUnit" class="form-label"></label><input asp-for="RatePerUnit" class="form-control" min="0" step="0.01" /><span asp-validation-for="RatePerUnit" class="text-danger small"></span></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Save bill</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
