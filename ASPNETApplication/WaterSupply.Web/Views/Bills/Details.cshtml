@model Bill
@{ ViewData["Title"] = "Bill Details"; }
<h1>Bill #@Model.Id</h1><dl class="row"><dt class="col-sm-3">Connection</dt><dd class="col-sm-9">@Model.WaterConnectionId</dd><dt class="col-sm-3">Billing period</dt><dd class="col-sm-9">@Model.BillingPeriodStart to @Model.BillingPeriodEnd</dd><dt class="col-sm-3">Consumption</dt><dd class="col-sm-9">@Model.UnitsConsumed</dd><dt class="col-sm-3">Total</dt><dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd><dt class="col-sm-3">Paid</dt><dd class="col-sm-9">@Model.PaidAmount.ToString("C")</dd><dt class="col-sm-3">Outstanding</dt><dd class="col-sm-9">@Model.OutstandingAmount.ToString("C")</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl><a asp-action="Index" class="btn btn-link">Back to bills</a>
