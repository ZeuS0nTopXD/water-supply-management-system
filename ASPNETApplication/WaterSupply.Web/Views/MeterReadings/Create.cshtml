@model WaterSupply.Web.Models.MeterReadingViewModels.MeterReadingEditViewModel
@{ ViewData["Title"] = "Record Meter Reading"; var connections = ViewBag.Connections as IEnumerable<WaterConnection> ?? []; }
<h1>Record meter reading</h1><form asp-action="Create" method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="WaterConnectionId" class="form-label"></label><select asp-for="WaterConnectionId" class="form-select"><option value="">Select connection</option>@foreach (var connection in connections) { <option value="@connection.Id">@connection.ConnectionNumber (resident @connection.ResidentId)</option> }</select><span asp-validation-for="WaterConnectionId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ReadingDate" class="form-label"></label><input asp-for="ReadingDate" class="form-control" /><span asp-validation-for="ReadingDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="PreviousReading" class="form-label"></label><input asp-for="PreviousReading" class="form-control" /><span asp-validation-for="PreviousReading" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CurrentReading" class="form-label"></label><input asp-for="CurrentReading" class="form-control" /><span asp-validation-for="CurrentReading" class="text-danger"></span></div><div class="col-12"><button class="btn btn-primary">Save reading</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
