@model MeterReadingEditViewModel
@{ ViewData["Title"] = "Record Reading"; var connections = ViewBag.Connections as IEnumerable<WaterConnection> ?? []; }
<h1>Record meter reading</h1>
<form asp-action="Create" method="post" class="row g-3 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="WaterConnectionId" class="form-label"></label><select asp-for="WaterConnectionId" class="form-select"><option value="">Select connection</option>@foreach (var connection in connections) { <option value="@connection.WaterConnectionId">@connection.ConnectionNumber</option> }</select></div>
    <div class="col-md-6"><label asp-for="ReadingDate" class="form-label"></label><input asp-for="ReadingDate" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="PreviousReading" class="form-label"></label><input asp-for="PreviousReading" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="CurrentReading" class="form-label"></label><input asp-for="CurrentReading" class="form-control" /></div>
    <div class="col-12"><button class="btn btn-primary">Save reading</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
