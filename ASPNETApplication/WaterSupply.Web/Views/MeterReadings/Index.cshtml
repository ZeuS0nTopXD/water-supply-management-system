@model IEnumerable<MeterReading>
@{ ViewData["Title"] = "Meter Readings"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Meter readings</h1><a asp-action="Create" class="btn btn-primary">Record reading</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><input name="waterConnectionId" class="form-control" placeholder="Connection ID" /></div><div class="col-md-3"><input name="from" type="date" class="form-control" /></div><div class="col-md-3"><input name="to" type="date" class="form-control" /></div><div class="col-md-3"><button class="btn btn-outline-secondary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Connection</th><th>Date</th><th>Previous</th><th>Current</th><th>Consumption</th></tr></thead><tbody>@foreach (var reading in Model) { <tr><td>@reading.WaterConnectionId</td><td>@reading.ReadingDate</td><td>@reading.PreviousReading</td><td>@reading.CurrentReading</td><td>@reading.Consumption</td></tr> }</tbody></table></div>
