@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="row justify-content-center"><div class="col-md-5">
    <h1>Login</h1>
    <form asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" />
        <label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3" />
        <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
        <button class="btn btn-primary">Login</button>
        <a class="btn btn-link" asp-action="Register">Create an account</a>
    </form>
</div></div>
