@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<h1>Change password</h1>
<form asp-action="ChangePassword" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control mb-3" />
    <label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control mb-3" />
    <label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control mb-3" />
    <button class="btn btn-primary">Change password</button>
</form>
