@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="row justify-content-center"><div class="col-md-6">
    <h1>Create account</h1>
    <p class="text-muted">Register as a resident to access the water supply dashboard.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control mb-3" />
        <label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" />
        <label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control mb-3" />
        <label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control mb-3" />
        <label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3" />
        <label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control mb-3" />
        <button class="btn btn-primary">Register</button>
        <a class="btn btn-link" asp-action="Login">Already have an account?</a>
    </form>
</div></div>
