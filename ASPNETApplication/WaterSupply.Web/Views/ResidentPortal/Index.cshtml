@model WaterSupply.Web.Models.ResidentPortalViewModel
@{ ViewData["Title"] = "Resident Portal"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Welcome, @Model.Resident.FullName</h1><div><button class="btn btn-outline-secondary" onclick="WaterSupplyPwa.requestBillReminderPermission()">Enable bill reminders</button> <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-primary">New service request</a></div></div>
<h2 class="h4">My bills</h2><div class="table-responsive mb-4"><table class="table table-striped"><thead><tr><th>Period end</th><th>Total</th><th>Outstanding</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var bill in Model.Bills) { <tr><td>@bill.BillingPeriodEnd</td><td>@bill.TotalAmount.ToString("C")</td><td>@bill.OutstandingAmount.ToString("C")</td><td>@bill.Status</td><td><a asp-action="Bill" asp-route-id="@bill.Id">View</a></td></tr> }</tbody></table></div>
<h2 class="h4">My service requests</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Type</th><th>Description</th><th>Status</th><th>Created</th></tr></thead><tbody>@foreach (var request in Model.ServiceRequests) { <tr><td>@request.RequestType</td><td>@request.Description</td><td>@request.Status</td><td>@request.CreatedAt.ToLocalTime()</td></tr> }</tbody></table></div>
