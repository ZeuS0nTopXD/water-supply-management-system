@model ResidentPortalViewModel
@{ ViewData["Title"] = "Resident Portal"; }
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div><h1 class="mb-1">Welcome, @Model.ResidentName</h1><p class="text-muted mb-0">View your water supply account and report a problem.</p></div>
    <div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" asp-controller="ConnectionRequests" asp-action="Create">Request a water connection</a><a class="btn btn-outline-primary" asp-controller="ServiceRequests" asp-action="Create">Report a service issue</a></div>
</div>
<section class="card mt-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Request a connection</h2><a asp-controller="ConnectionRequests" asp-action="Index">View status</a></div>
        @if (Model.ConnectionRequests.Count == 0)
        {
            <p class="text-muted mb-0">No connection application has been submitted. Each apartment can have one water connection.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Type</th><th>Address</th><th>Submitted</th><th>Status</th><th>Administrator note</th></tr></thead><tbody>@foreach (var request in Model.ConnectionRequests.Take(5)) { <tr><td>@request.RequestedType</td><td class="text-break">@request.ServiceAddress</td><td>@request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td>@request.StatusLabel</td><td class="text-break">@(request.StaffNotes ?? "Awaiting review")</td></tr> }</tbody></table></div>
        }
    </div>
</section>
<div class="row g-3">
    <div class="col-lg-6"><section class="card h-100"><div class="card-body"><h2 class="h5">My connections</h2>@if (Model.Connections.Count == 0) { <div class="alert alert-info mb-0">Your resident account is ready, but an administrator must assign a water connection before connection-specific readings and bills are available.</div> } else { <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Connection number</th><th>Meter</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach (var connection in Model.Connections) { <tr><td>@connection.ConnectionNumber</td><td>@connection.MeterNumber</td><td>@connection.ConnectionType</td><td>@(connection.Status == ConnectionStatus.Active ? "Active" : "Inactive")</td></tr> }</tbody></table></div> }</div></section></div>
    <div class="col-lg-6"><section class="card h-100"><div class="card-body"><h2 class="h5">My bills</h2>@if (Model.Bills.Count == 0) { <p class="text-muted mb-0">No bills are available.</p> } else { <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Connection</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead><tbody>@foreach (var bill in Model.Bills) { <tr><td>@bill.ConnectionNumber</td><td>@bill.BillDate</td><td>@bill.TotalAmount.ToString("C")</td><td>@bill.Status</td></tr> }</tbody></table></div> }</div></section></div>
    <div class="col-lg-6"><section class="card h-100"><div class="card-body"><h2 class="h5">Recent readings</h2>@if (Model.Readings.Count == 0) { <p class="text-muted mb-0">No readings are available.</p> } else { <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Connection</th><th>Date</th><th>Consumption</th></tr></thead><tbody>@foreach (var reading in Model.Readings.Take(5)) { <tr><td>@reading.ConnectionNumber</td><td>@reading.ReadingDate</td><td>@reading.Consumption units</td></tr> }</tbody></table></div> }</div></section></div>
    <div class="col-lg-6"><section class="card h-100"><div class="card-body"><h2 class="h5">My service requests</h2>@if (Model.ServiceRequests.Count == 0) { <p class="text-muted mb-0">No service requests have been submitted.</p> } else { <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Type</th><th>Connection</th><th>Status</th></tr></thead><tbody>@foreach (var request in Model.ServiceRequests.Take(5)) { <tr><td>@request.RequestType</td><td>@(request.ConnectionNumber ?? "Not connection-specific")</td><td>@request.Status</td></tr> }</tbody></table></div> }</div></section></div>
</div>
