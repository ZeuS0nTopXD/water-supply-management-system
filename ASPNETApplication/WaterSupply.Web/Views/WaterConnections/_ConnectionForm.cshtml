@model WaterSupply.Web.Models.ConnectionViewModels.ConnectionEditViewModel
<form method="post" class="row g-3 col-md-8"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="ResidentId" class="form-label"></label><input asp-for="ResidentId" class="form-control" /></div><div class="col-md-6"><label asp-for="ConnectionNumber" class="form-label"></label><input asp-for="ConnectionNumber" class="form-control" /></div><div class="col-md-6"><label asp-for="MeterNumber" class="form-label"></label><input asp-for="MeterNumber" class="form-control" /></div><div class="col-md-6"><label asp-for="ConnectionDate" class="form-label"></label><input asp-for="ConnectionDate" class="form-control" type="date" /></div><div class="col-md-6"><label asp-for="ConnectionType" class="form-label"></label><select asp-for="ConnectionType" asp-items="Html.GetEnumSelectList<ConnectionType>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ConnectionStatus>()" class="form-select"></select></div><div class="col-12"><button type="submit" class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
