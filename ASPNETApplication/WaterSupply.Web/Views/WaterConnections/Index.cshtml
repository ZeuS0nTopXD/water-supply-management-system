@model IEnumerable<WaterConnection>
@{ ViewData["Title"] = "Water Connections"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Water connections</h1><a class="btn btn-primary" asp-action="Create">Add connection</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search connection or meter" /></div><div class="col-sm-4"><button class="btn btn-outline-secondary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Connection</th><th>Meter</th><th>Resident</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach (var connection in Model) { <tr><td>@connection.ConnectionNumber</td><td>@connection.MeterNumber</td><td>@connection.ResidentId</td><td>@connection.ConnectionType</td><td>@connection.Status</td></tr> }</tbody></table></div>
