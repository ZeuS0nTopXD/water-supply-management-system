@model IEnumerable<WaterConnection>
@{ ViewData["Title"] = "Water Connections"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Water connections</h1><a class="btn btn-primary" asp-action="Create">Add connection</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><label class="visually-hidden" for="connection-search">Search connections</label><input id="connection-search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by connection or meter number" /></div><div class="col-sm-4"><button class="btn btn-outline-secondary w-100" type="submit">Search connections</button></div></form>
@if (!Model.Any())
{
    <div class="alert alert-light border">No water connections match your search.</div>
}
else
{
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Connection number</th><th>Meter number</th><th>Resident ID</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach (var connection in Model) { <tr><td>@connection.ConnectionNumber</td><td>@connection.MeterNumber</td><td>@connection.ResidentId</td><td>@connection.ConnectionType</td><td>@connection.Status</td></tr> }</tbody></table></div>
}
