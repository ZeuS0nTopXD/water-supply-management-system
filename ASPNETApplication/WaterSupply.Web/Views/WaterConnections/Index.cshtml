@model IEnumerable<WaterConnection>
@{ ViewData["Title"] = "Water Connections"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Water Connections</h1><a asp-action="Create" class="btn btn-primary">Add connection</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search connection or meter number" /></div><div class="col-sm-4"><button class="btn btn-outline-secondary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Connection</th><th>Meter</th><th>Resident ID</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var connection in Model) { <tr><td>@connection.ConnectionNumber</td><td>@connection.MeterNumber</td><td>@connection.ResidentId</td><td>@connection.Status</td><td><a asp-action="Details" asp-route-id="@connection.Id">Details</a> | <a asp-action="Edit" asp-route-id="@connection.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@connection.Id">Delete</a></td></tr> }</tbody></table></div>
