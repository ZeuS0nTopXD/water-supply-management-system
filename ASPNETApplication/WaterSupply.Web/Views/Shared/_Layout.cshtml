<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WaterSupply.Web</title>
    <meta name="theme-color" content="#0f766e" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" media="print" />
    <link rel="stylesheet" href="~/WaterSupply.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @if (User.IsInRole("Administrator"))
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">Water Supply Management</a>
                }
                else if (User.IsInRole("Resident"))
                {
                    <a class="navbar-brand" asp-area="" asp-controller="ResidentPortal" asp-action="Index">Water Supply Management</a>
                }
                else
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Water Supply Management</a>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Residents" asp-action="Index">Residents</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="WaterConnections" asp-action="Index">Connections</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Bills" asp-action="Index">Bills</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="ServiceRequests" asp-action="Index">Requests</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reports" asp-action="OutstandingBills">Reports</a></li>
                        }
                        else if (User.IsInRole("Resident"))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="ResidentPortal" asp-action="Index">My portal</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Bills" asp-action="Index">My bills</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="ServiceRequests" asp-action="Index">My requests</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WaterSupply.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa-notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
