<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Water Supply</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/print.css" />
</head>
<body>
<header class="border-bottom bg-white">
    <nav class="navbar navbar-expand-lg container" aria-label="Primary navigation">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Water Supply</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">Menu</button>
        <div id="mainNav" class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Residents" asp-action="Index">Residents</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="WaterConnections" asp-action="Index">Connections</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="MeterReadings" asp-action="Index">Readings</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Bills" asp-action="Index">Bills</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">Requests</a></li>
                    @if (User.IsInRole("Resident"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">My profile</a></li>
                    }
                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                    }
                }
            </ul>
            <div class="d-flex gap-2 align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-danger">Logout</button></form>
                }
                else
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
    </nav>
</header>
<main id="main-content" class="container py-4">@RenderBody()</main>
<footer class="container border-top py-3 text-muted small">Water Supply Management System</footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
<script src="~/js/pwa-notifications.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
