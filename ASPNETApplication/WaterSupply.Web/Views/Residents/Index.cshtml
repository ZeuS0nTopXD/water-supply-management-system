@model IEnumerable<Resident>
@{ ViewData["Title"] = "Residents"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Residents</h1><a class="btn btn-primary" asp-action="Create">Add resident</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or email" /></div><div class="col-sm-4"><button class="btn btn-outline-secondary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var resident in Model) { <tr><td>@resident.FullName</td><td>@resident.Email</td><td>@resident.Phone</td><td>@(resident.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Edit" asp-route-id="@resident.ResidentId">Edit</a> <form asp-action="Delete" asp-route-id="@resident.ResidentId" method="post" class="d-inline"><button class="btn btn-link p-0 text-danger" onclick="return confirm('Delete this resident?')">Delete</button></form></td></tr> }
</tbody></table></div>
