@model IEnumerable<Resident>
@{ ViewData["Title"] = "Residents"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Residents</h1><a asp-action="Create" class="btn btn-primary">Add resident</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name, email, or phone" /></div><div class="col-sm-4"><button class="btn btn-outline-secondary" type="submit">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var resident in Model) { <tr><td>@resident.FullName</td><td>@resident.Email</td><td>@resident.Phone</td><td>@(resident.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Details" asp-route-id="@resident.Id">Details</a> | <a asp-action="Edit" asp-route-id="@resident.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@resident.Id">Delete</a></td></tr> }
</tbody></table></div>
