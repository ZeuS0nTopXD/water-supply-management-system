@model IEnumerable<Resident>
@{ ViewData["Title"] = "Residents"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Residents</h1><a class="btn btn-primary" asp-action="Create">Add resident</a></div>
@if (ViewBag.Error is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><label class="visually-hidden" for="resident-search">Search residents</label><input id="resident-search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email" /></div><div class="col-sm-4"><button class="btn btn-outline-secondary w-100" type="submit">Search residents</button></div></form>
@if (!Model.Any())
{
    <div class="alert alert-light border">No residents match your search.</div>
}
else
{
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var resident in Model) { <tr><td>@resident.FullName</td><td>@resident.Email</td><td>@resident.Phone</td><td>@(resident.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Edit" asp-route-id="@resident.ResidentId">Edit</a> <form asp-action="Delete" asp-route-id="@resident.ResidentId" method="post" class="d-inline"><button class="btn btn-link p-0 text-danger" onclick="return confirm('Delete this resident?')">Delete</button></form></td></tr> }
</tbody></table></div>
}
