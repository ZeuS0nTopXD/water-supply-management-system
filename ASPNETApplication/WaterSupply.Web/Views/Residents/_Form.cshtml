@model ResidentEditViewModel
<div class="alert alert-info" role="note">
    <strong>How the resident logs in:</strong> this creates a resident profile for staff records. Tell the resident to open <a asp-controller="Account" asp-action="Register">registration</a> and register using this exact email address. Registration creates their password, links this profile, and takes them to the resident portal. A new manual profile starts as <strong>Not activated</strong> until they register.
</div>
<form method="post" class="row g-3 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="e.g. Asha Patil" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="10-digit phone number" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="RegistrationDate" class="form-label"></label><input asp-for="RegistrationDate" class="form-control" /><span asp-validation-for="RegistrationDate" class="text-danger small"></span></div>
    <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" autocomplete="street-address" placeholder="Street and locality" /><span asp-validation-for="Address" class="text-danger small"></span></div>
    <div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label><span asp-validation-for="IsActive" class="text-danger small d-block"></span></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Save resident</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
