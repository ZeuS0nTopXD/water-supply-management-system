erDiagram
    Residents ||--o{ WaterConnections : owns
    WaterConnections ||--o{ MeterReadings : has
    WaterConnections ||--o{ Bills : generates
    Bills ||--o{ Payments : receives
    Residents ||--o{ ServiceRequests : creates
    WaterConnections o|--o{ ServiceRequests : concerns
    Residents ||--o{ Notifications : receives

    Residents {
        int ResidentId PK
        string IdentityUserId UK
        string FullName
        string Email
        string Phone
        string Address
        date RegistrationDate
        bool IsActive
    }
    WaterConnections {
        int WaterConnectionId PK
        int ResidentId FK
        string ConnectionNumber UK
        string ConnectionType
        string MeterNumber
        date ConnectionDate
        string Status
    }
    MeterReadings {
        int MeterReadingId PK
        int WaterConnectionId FK
        date ReadingDate
        decimal PreviousReading
        decimal CurrentReading
        decimal Consumption
    }
    Bills {
        int BillId PK
        int WaterConnectionId FK
        date BillingPeriodStart
        date BillingPeriodEnd
        decimal TotalAmount
        decimal PaidAmount
        date DueDate
        string Status
    }
    Payments {
        int PaymentId PK
        int BillId FK
        datetime PaymentDate
        decimal Amount
        string PaymentMethod
        string ReferenceNumber UK
    }
    ServiceRequests {
        int ServiceRequestId PK
        int ResidentId FK
        int WaterConnectionId FK
        string RequestType
        string Description
        datetime CreatedAt
        string Status
    }
    Notifications {
        int NotificationId PK
        int ResidentId FK
        string Title
        string Message
        string NotificationType
        datetime CreatedAt
        datetime ReadAt
    }
